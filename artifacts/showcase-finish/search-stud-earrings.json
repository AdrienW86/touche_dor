ae and their replications: Stones and steel at the end of the Bronze Age”. The possibility of applying texture was deactivated as only metric information and no photographic information was needed for this study.</br></br>\nhttps://doi.org/10.1016/j.jas.2025.106340","faceCount":357071,"createdAt":"2025-07-06T12:36:45.326704","vertexCount":180527,"isAgeRestricted":false,"archives":{"glb":{"textureCount":0,"size":9814632,"type":"glb","textureMaxResolution":0,"faceCount":357071,"vertexCount":230257},"gltf":{"textureCount":0,"size":6114941,"type":"gltf","textureMaxResolution":0,"faceCount":357071,"vertexCount":230257},"source":{"textureCount":null,"size":8670955,"type":"source","textureMaxResolution":null,"faceCount":null,"vertexCount":null},"usdz":{"textureCount":null,"size":6564967,"type":"usdz","textureMaxResolution":null,"faceCount":null,"vertexCount":null}},"license":{"uid":"34b725081a6a4184957efaec2cb84ed3","label":"CC Attribution-NonCommercial-NoDerivs"}}]}